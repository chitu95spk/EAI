<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>EasyLabel.Ai.Mcp</RootNamespace>
    <AssemblyName>EasyLabel.Ai.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyLabel.Ai.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyLabel.Ai.Onnx\EasyLabel.Ai.Onnx.csproj" />
    <ProjectReference Include="..\EasyLabel.Core\EasyLabel.Core.csproj" />
    <ProjectReference Include="..\EasyLabel.LabelHarness\EasyLabel.LabelHarness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent-facing skill text; the runner passes these files to the agent as system-prompt text. -->
    <None Include="Skills\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
