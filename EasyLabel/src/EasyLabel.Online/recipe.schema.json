{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:easylabel:online:recipe:1",
  "title": "EasyLabel offline-frozen recipe, revision 1",
  "$comment": "RecipeJson additionally checks contiguous class-map parity, channel/vector lengths, calibration linkage and the closed verdict grammar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaRev", "catalogVersion", "classes", "position", "nms", "verdict", "preprocess", "wire", "thresholds", "classMap", "model"],
  "properties": {
    "schemaRev": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "classes": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/class" } },
    "position": { "$ref": "#/$defs/position" },
    "nms": { "type": "number", "minimum": 0, "maximum": 1 },
    "verdict": {
      "type": "object", "additionalProperties": false, "required": ["ng_if"],
      "properties": { "ng_if": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" } }
    },
    "preprocess": { "$ref": "#/$defs/preprocess" },
    "wire": {
      "type": "object", "additionalProperties": false, "required": ["codec", "includeDetections", "maxPayloadBytes"],
      "properties": {
        "codec": { "const": "json" }, "includeDetections": { "type": "boolean" },
        "maxPayloadBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "thresholds": {
      "type": "object", "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "classMap": {
      "type": "object", "minProperties": 1, "maxProperties": 1024,
      "propertyNames": { "pattern": "^(0|[1-9][0-9]{0,3})$" },
      "additionalProperties": { "$ref": "#/$defs/identifier" }
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["fileName", "sha256"],
      "properties": {
        "fileName": { "enum": ["model.onnx", "model.segai"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z_][A-Za-z_0-9]*$" },
    "class": {
      "type": "object", "additionalProperties": false, "required": ["name", "minScore", "minAreaPx", "maxCount", "roi"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "minScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "minAreaPx": { "type": "number", "minimum": 0, "maximum": 1000000000000 },
        "maxCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "roi": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array", "minItems": 4, "maxItems": 4,
              "prefixItems": [
                { "type": "number", "minimum": 0, "maximum": 10000000 },
                { "type": "number", "minimum": 0, "maximum": 10000000 },
                { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
                { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 }
              ]
            }
          ]
        }
      }
    },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["mode", "units", "calib"],
      "properties": {
        "mode": { "enum": ["bbox", "centroid", "polygon"] }, "units": { "enum": ["px", "mm"] },
        "calib": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }] }
      },
      "if": { "properties": { "units": { "const": "mm" } } },
      "then": { "properties": { "calib": { "$ref": "#/$defs/identifier" } } }
    },
    "preprocess": {
      "type": "object", "additionalProperties": false,
      "required": ["inputWidth", "inputHeight", "channels", "colorOrder", "interpolation", "scale", "mean", "std", "letterbox", "seed"],
      "properties": {
        "inputWidth": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "inputHeight": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "channels": { "enum": [1, 3] }, "colorOrder": { "enum": ["GRAY", "RGB", "BGR"] },
        "interpolation": { "enum": ["nearest", "bilinear"] },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "mean": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 } },
        "std": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 } },
        "letterbox": { "type": "boolean" }, "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    }
  }
}
