<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>EasyAI.Desktop</RootNamespace>
    <AssemblyName>EasyAI</AssemblyName>
    <!-- The exe / taskbar icon. Generated from the logo by tmp/EAI/EAI-UI/make-icon.ps1; used as soon as the file exists. -->
    <ApplicationIcon Condition="Exists('Assets\EasyAI.ico')">Assets\EasyAI.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyLabel.Core\EasyLabel.Core.csproj" />
    <ProjectReference Include="..\EasyLabel.Commands\EasyLabel.Commands.csproj" />
    <ProjectReference Include="..\EasyLabel.Online\EasyLabel.Online.csproj" />
    <ProjectReference Include="..\EasyLabel.SegAI\EasyLabel.SegAI.csproj" />
    <ProjectReference Include="..\EasyLabel.Camera\EasyLabel.Camera.csproj" />
    <ProjectReference Include="..\EasyLabel.Ai.Onnx\EasyLabel.Ai.Onnx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Claude Code agent's MCP tool server (a separate console exe). It is built first, but its assembly is not referenced:
         the target below copies its whole output (exe, dependencies, native runtimes, Skills\*.md) to <OutDir>agent\. -->
    <ProjectReference Include="..\EasyLabel.Ai.Mcp\EasyLabel.Ai.Mcp.csproj" ReferenceOutputAssembly="false" OutputItemType="AgentToolsOutput" />
  </ItemGroup>

  <Target Name="CopyAgentTools" AfterTargets="Build" Condition="'@(AgentToolsOutput)' != ''">
    <PropertyGroup>
      <_AgentToolsSourceDir>%(AgentToolsOutput.RootDir)%(AgentToolsOutput.Directory)</_AgentToolsSourceDir>
    </PropertyGroup>
    <ItemGroup>
      <_AgentToolsFile Include="$(_AgentToolsSourceDir)**\*" Exclude="$(_AgentToolsSourceDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentToolsFile)"
          DestinationFiles="@(_AgentToolsFile->'$(OutDir)agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- SAM3 image encoder on the NVIDIA GPU (own process, ONNX Runtime GPU + CUDA 13). Copied to <OutDir>cuda\ together with the CUDA 13 / cuDNN 9 DLLs staged in
       Lib\native\cuda13 (about 1.6 GB, git-ignored: pip's nvidia-cuda-runtime, nvidia-cublas, nvidia-cudnn-cu13, nvidia-cufft, nvidia-curand, nvidia-cuda-nvrtc, nvidia-nvjitlink).
       Without the DLLs SAM3 falls back to DirectML/CPU (its encoder fails on DirectML, so CPU). -->
  <ItemGroup>
    <ProjectReference Include="..\EasyLabel.Ai.Sam3Cuda\EasyLabel.Ai.Sam3Cuda.csproj" ReferenceOutputAssembly="false" OutputItemType="CudaWorkerOutput" />
  </ItemGroup>
  <PropertyGroup>
    <CudaLibsDir Condition="'$(CudaLibsDir)' == ''">$(MSBuildThisFileDirectory)..\..\Lib\native\cuda13\</CudaLibsDir>
  </PropertyGroup>
  <Target Name="CopyCudaWorker" AfterTargets="Build" Condition="'@(CudaWorkerOutput)' != ''">
    <PropertyGroup>
      <_CudaWorkerSourceDir>%(CudaWorkerOutput.RootDir)%(CudaWorkerOutput.Directory)</_CudaWorkerSourceDir>
    </PropertyGroup>
    <ItemGroup>
      <_CudaWorkerFile Include="$(_CudaWorkerSourceDir)**\*" Exclude="$(_CudaWorkerSourceDir)**\*.pdb" />
      <_CudaLibFile Include="$(CudaLibsDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_CudaWorkerFile)"
          DestinationFiles="@(_CudaWorkerFile->'$(OutDir)cuda\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CudaLibFile)" DestinationFolder="$(OutDir)cuda\" SkipUnchangedFiles="true" />
    <Warning Condition="'@(_CudaLibFile)' == ''" Text="CUDA 13 / cuDNN 9 DLLs not found in $(CudaLibsDir): SAM3 will not use the NVIDIA GPU until they are staged there." />
  </Target>

  <!-- App-local VC++ runtime (Lib\vcrt, from Microsoft.VC143.CRT 14.44): BeeNativeSegAI.dll and torch_cpu.dll need it, and a PC without the
       VC++ 2015-2022 x64 Redistributable fails to load them (SegmentAI DLL error on the first Segment AI action). -->
  <ItemGroup>
    <None Include="..\..\Lib\vcrt\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Segment AI native set (BeeNativeSegAI.dll, libtorch, OpenCV, OpenVINO, Models\DefectV2; about 500 MB, git-ignored). Stage it in Lib\native\segai (or pass -p:SegAiNativeDir=...)
       and every build copies it next to EasyAI.exe; without it the app says "The Segment AI library is not loaded". -->
  <PropertyGroup>
    <SegAiNativeDir Condition="'$(SegAiNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Lib\native\segai\</SegAiNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SegAiNativeDir)BeeNativeSegAI.dll')">
    <None Include="$(SegAiNativeDir)**" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnSegAiNativeMissing" BeforeTargets="Build" Condition="!Exists('$(SegAiNativeDir)BeeNativeSegAI.dll')">
    <Warning Text="Segment AI native set not found in $(SegAiNativeDir): the built app cannot train or run Segment AI until BeeNativeSegAI.dll and its libtorch files are copied next to EasyAI.exe." />
  </Target>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\docs\easyai\guide.md" Link="docs\guide.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ScottPlot.WPF" VersionOverride="5.1.59" />
    <!-- Dockable / floating panels. Themes.VS2013 supplies the light and dark chrome (switched at run time with the WPF-UI theme). -->
    <PackageReference Include="Dirkster.AvalonDock" VersionOverride="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" VersionOverride="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" VersionOverride="5.0.1" />
  </ItemGroup>

</Project>
