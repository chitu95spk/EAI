<ui:FluentWindow x:Class="EasyAI.Desktop.Views.McpApprovalDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 Width="680"
                 Height="640"
                 MinWidth="420"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="McpApprovalDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,8">
                <ui:TextBlock x:Name="StatementText"
                              Margin="0,0,0,12"
                              FontTypography="BodyStrong"
                              TextWrapping="Wrap"
                              AutomationProperties.AutomationId="McpApprovalStatement" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldName}" />
                <ui:TextBlock x:Name="NameText" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalName" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldSource}" />
                <ui:TextBlock x:Name="SourceText" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalSource" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldVersion}" />
                <ui:TextBlock x:Name="VersionText" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalVersion" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldCommand}" />
                <ui:TextBlock x:Name="CommandText" Margin="0,0,0,8" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalCommand" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldArgs}" />
                <ui:TextBlock x:Name="ArgsText" Margin="0,0,0,8" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalArgs" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldWorkingFolder}" />
                <ui:TextBlock x:Name="WorkingFolderText" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalWorkingFolder" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldAccess}" />
                <ui:TextBlock x:Name="AccessText" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalAccess" />

                <ui:TextBlock Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.McpFieldTools}" />
                <ui:TextBlock x:Name="ToolsText" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AutomationId="McpApprovalTools" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="16,4,16,16"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0"
                       Appearance="Secondary"
                       Content="{x:Static res:Strings.McpApprove}"
                       Click="OnApprove"
                       AutomationProperties.AutomationId="McpApprovalApprove" />
            <ui:Button Appearance="Primary"
                       IsDefault="True"
                       IsCancel="True"
                       Content="{x:Static res:Strings.Cancel}"
                       AutomationProperties.AutomationId="McpApprovalCancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
