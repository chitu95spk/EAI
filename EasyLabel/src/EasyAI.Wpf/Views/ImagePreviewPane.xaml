<UserControl x:Class="EasyAI.Desktop.Views.ImagePreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources">
    <Grid>
        <Image Margin="8"
               Source="{Binding PreviewImage}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               AutomationProperties.AutomationId="PreviewImage"
               AutomationProperties.Name="{x:Static res:Strings.PreviewImage}" />
    </Grid>
</UserControl>
