<ui:FluentWindow x:Class="EasyAI.Desktop.Views.McpServerEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 Width="680"
                 Height="640"
                 MinWidth="420"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="McpServerEditDialog"
                 Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,8">
                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldName}" />
                <ui:TextBox x:Name="NameBox"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="McpName"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldName}" />

                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldSource}" />
                <ui:TextBox x:Name="SourceBox"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="McpSource"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldSource}" />

                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldVersion}" />
                <ui:TextBox x:Name="VersionBox"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="McpVersion"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldVersion}" />

                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldCommand}" />
                <ui:TextBox x:Name="CommandBox"
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="McpCommand"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldCommand}" />

                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldArgs}" />
                <ui:TextBox x:Name="ArgsBox"
                            Margin="0,0,0,8"
                            MinHeight="72"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            TextWrapping="NoWrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="McpArgs"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldArgs}" />

                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldAccess}" />
                <ui:TextBox x:Name="AccessBox"
                            Margin="0,0,0,8"
                            MinHeight="72"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="McpAccess"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldAccess}" />

                <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.McpFieldTools}" />
                <ui:TextBox x:Name="ToolsBox"
                            MinHeight="72"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            TextWrapping="NoWrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="McpTools"
                            AutomationProperties.Name="{x:Static res:Strings.McpFieldTools}" />
            </StackPanel>
        </ScrollViewer>

        <ui:TextBlock x:Name="ErrorText"
                      Grid.Row="2"
                      Margin="16,0,16,4"
                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                      TextWrapping="Wrap"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="McpError" />

        <StackPanel Grid.Row="3"
                    Margin="16,4,16,16"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0"
                       Appearance="Primary"
                       Content="{x:Static res:Strings.AgentsSave}"
                       Click="OnSave"
                       AutomationProperties.AutomationId="McpSave" />
            <ui:Button Appearance="Secondary"
                       IsCancel="True"
                       Content="{x:Static res:Strings.Cancel}"
                       AutomationProperties.AutomationId="McpCancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
