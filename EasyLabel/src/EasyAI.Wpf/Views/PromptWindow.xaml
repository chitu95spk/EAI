<ui:FluentWindow x:Class="EasyAI.Desktop.Views.PromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="460"
                 MinWidth="360"
                 MaxHeight="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="PromptWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="PromptTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer x:Name="ContentScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="16,8,16,8">
                <ui:TextBlock x:Name="MessageText"
                              TextWrapping="Wrap"
                              AutomationProperties.AutomationId="PromptMessage" />
                <ui:TextBlock x:Name="DetailsText"
                              Margin="0,8,0,0"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AutomationId="PromptDetails" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ButtonPanel"
                    Grid.Row="2"
                    Margin="16,4,16,16"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:SymbolIcon x:Name="PromptIcon"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Symbol="Delete24"
                           Visibility="Collapsed" />
            <ui:Button x:Name="PrimaryButton"
                       Margin="0,0,8,0"
                       Appearance="Primary"
                       IsDefault="True"
                       Click="OnPrimary"
                       AutomationProperties.AutomationId="PromptPrimary" />
            <ui:Button x:Name="SecondaryButton"
                       Margin="0,0,8,0"
                       Appearance="Secondary"
                       Click="OnSecondary"
                       AutomationProperties.AutomationId="PromptSecondary" />
            <ui:Button x:Name="CancelButton"
                       Appearance="Secondary"
                       IsCancel="True"
                       AutomationProperties.AutomationId="PromptCancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
