<ui:FluentWindow x:Class="EasyAI.Desktop.Views.NewLabelDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 Width="380"
                 MinWidth="300"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="NewLabelDialog"
                 Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ui:TextBox x:Name="NameBox"
                    Grid.Row="1"
                    Margin="16,8,16,8"
                    PlaceholderText="{x:Static res:Strings.NewLabelPlaceholder}"
                    AutomationProperties.AutomationId="NewLabelText"
                    AutomationProperties.Name="{x:Static res:Strings.NewLabelPlaceholder}" />

        <StackPanel Grid.Row="2"
                    Margin="16,4,16,16"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0"
                       Appearance="Primary"
                       IsDefault="True"
                       Content="{x:Static res:Strings.LblDlgOk}"
                       Click="OnOk"
                       AutomationProperties.AutomationId="NewLabelOk" />
            <ui:Button Appearance="Secondary"
                       IsCancel="True"
                       Content="{x:Static res:Strings.Cancel}"
                       AutomationProperties.AutomationId="NewLabelCancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
