<ui:FluentWindow x:Class="EasyAI.Desktop.Views.ClassTableDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 Title="{x:Static res:Strings.ClassEditTitle}"
                 Width="560"
                 Height="460"
                 MinWidth="420"
                 MinHeight="300"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="ClassTableDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:Strings.ClassEditTitle}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <!-- Header and rows share column widths (SharedSizeGroup); the rows scroll when the window is short. -->
        <Grid Grid.Row="1"
              Margin="16,8,16,0"
              Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ClassEditKindColumn" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ClassEditEnabledColumn" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Margin="0,0,8,0" Text="{x:Static res:Strings.ClassEditColName}" />
                <ui:TextBlock Grid.Column="1" Margin="0,0,8,0" Text="{x:Static res:Strings.ClassEditColKind}" />
                <ui:TextBlock Grid.Column="2" Text="{x:Static res:Strings.ClassEditColEnabled}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}"
                              AutomationProperties.AutomationId="ClassEditRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ClassEditKindColumn" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ClassEditEnabledColumn" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.AutomationId="{Binding Position, StringFormat=ClassEditName_{0}}"
                                            AutomationProperties.Name="{x:Static res:Strings.ClassEditColName}" />
                                <StackPanel Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton Margin="0,0,12,0"
                                                 GroupName="{Binding GroupName}"
                                                 Content="{x:Static res:Strings.ClassEditKindDefect}"
                                                 IsChecked="{Binding IsDefect, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding Position, StringFormat=ClassEditDefect_{0}}" />
                                    <RadioButton GroupName="{Binding GroupName}"
                                                 Content="{x:Static res:Strings.ClassEditKindGood}"
                                                 IsChecked="{Binding IsGood, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding Position, StringFormat=ClassEditGood_{0}}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding Position, StringFormat=ClassEditEnabled_{0}}"
                                                 AutomationProperties.Name="{x:Static res:Strings.ClassEditColEnabled}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <ui:InfoBar Grid.Row="2"
                    Margin="16,8,16,0"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorText}"
                    AutomationProperties.AutomationId="ClassEditError" />

        <Grid Grid.Row="3" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       Appearance="Secondary"
                       Content="{x:Static res:Strings.ClassEditAdd}"
                       Command="{Binding AddClassCommand}"
                       AutomationProperties.AutomationId="ClassEditAdd" />
            <ui:Button Grid.Column="2"
                       Margin="0,0,8,0"
                       Appearance="Primary"
                       IsDefault="True"
                       Content="{x:Static res:Strings.LblDlgOk}"
                       Click="OnOk"
                       AutomationProperties.AutomationId="ClassEditOk" />
            <ui:Button Grid.Column="3"
                       Appearance="Secondary"
                       IsCancel="True"
                       Content="{x:Static res:Strings.Cancel}"
                       AutomationProperties.AutomationId="ClassEditCancel" />
        </Grid>
    </Grid>
</ui:FluentWindow>
