<UserControl x:Class="EasyAI.Desktop.Views.TrainChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!-- Central area of the Train tab: the loss and validation IoU curves, large. DataContext: MainViewModel. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TextBlock Grid.Row="0"
                      Margin="0,0,0,6"
                      FontTypography="BodyStrong"
                      Text="{x:Static res:Strings.ChartHeader}" />
        <sp:WpfPlot x:Name="LossPlot"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    MinHeight="120"
                    AutomationProperties.AutomationId="LossChart"
                    AutomationProperties.Name="{x:Static res:Strings.ChartLoss}" />
        <sp:WpfPlot x:Name="IouPlot"
                    Grid.Row="2"
                    MinHeight="120"
                    AutomationProperties.AutomationId="IouChart"
                    AutomationProperties.Name="{x:Static res:Strings.ChartIou}" />
    </Grid>
</UserControl>
