<UserControl x:Class="EasyAI.Desktop.Views.LiveCameraParamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:EasyAI.Desktop.ViewModels"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
             MinWidth="240"
             IsEnabled="{Binding IsConnected}"
             AutomationProperties.AutomationId="LiveCameraParams">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Auto button: accent while the camera's auto mode is on. -->
        <Style x:Key="AutoButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuto}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:LiveNumberParamViewModel}">
            <StackPanel Margin="0,0,0,10" IsEnabled="{Binding IsEditable}">
                <ui:TextBlock Margin="0,0,0,2"
                              TextWrapping="Wrap"
                              Text="{Binding Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:NumberBox Grid.Column="0"
                                  MinWidth="120"
                                  Minimum="{Binding Minimum}"
                                  Maximum="{Binding Maximum}"
                                  SmallChange="{Binding SmallChange}"
                                  LargeChange="{Binding LargeChange}"
                                  MaxDecimalPlaces="{Binding MaxDecimalPlaces}"
                                  SpinButtonPlacementMode="Inline"
                                  Value="{Binding EditValue, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding Label}"
                                  AutomationProperties.ItemStatus="{Binding Display}" />
                    <ui:Button Grid.Column="1"
                               Margin="6,0,0,0"
                               Style="{StaticResource AutoButtonStyle}"
                               Content="{x:Static res:Strings.LiveAuto}"
                               Command="{Binding ToggleAutoCommand}"
                               Visibility="{Binding SupportsAuto, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="{Binding AutoAutomationId}" />
                </Grid>
                <ui:TextBlock Margin="0,2,0,0"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                              Text="{Binding Error}"
                              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.AutomationId="{Binding ErrorAutomationId}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveOptionParamViewModel}">
            <StackPanel Margin="0,0,0,10" IsEnabled="{Binding IsEditable}">
                <ui:TextBlock Margin="0,0,0,2"
                              TextWrapping="Wrap"
                              Text="{Binding Label}" />
                <ComboBox HorizontalAlignment="Stretch"
                          MinWidth="120"
                          ItemsSource="{Binding Options}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedValue, Mode=TwoWay}"
                          AutomationProperties.AutomationId="{Binding AutomationId}"
                          AutomationProperties.Name="{Binding Label}"
                          AutomationProperties.ItemStatus="{Binding Display}" />
                <ui:TextBlock Margin="0,2,0,0"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                              Text="{Binding Error}"
                              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.AutomationId="{Binding ErrorAutomationId}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- DataContext: LiveCameraViewModel. Right panel of the Live camera tab (the host scrolls it); greyed while the camera is not connected. -->
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0"
                          VerticalAlignment="Center"
                          FontTypography="BodyStrong"
                          Text="{x:Static res:Strings.LiveParamsTitle}" />
            <ui:Button Grid.Column="1"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Content="{x:Static res:Strings.LiveRefresh}"
                       Command="{Binding RefreshParamsCommand}"
                       AutomationProperties.AutomationId="LiveParamsRefresh" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}"
                      Focusable="False"
                      AutomationProperties.AutomationId="LiveParamsList"
                      AutomationProperties.Name="{x:Static res:Strings.LiveParamsTitle}" />
    </StackPanel>
</UserControl>
