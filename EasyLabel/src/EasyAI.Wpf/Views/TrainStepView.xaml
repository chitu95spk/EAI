<UserControl x:Class="EasyAI.Desktop.Views.TrainStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Caption of a segmented trainer button: accent text colour while its button is checked (same as the Step 2 source switch). -->
        <Style x:Key="KindCaptionStyle" TargetType="ui:TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource EasyAiAccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Dataset -->
        <ui:Card Margin="0,0,0,8" Padding="10,6,10,6">
            <StackPanel>
                <ui:TextBlock Margin="0,0,0,2"
                              FontTypography="BodyStrong"
                              Text="{x:Static res:Strings.DataSummary}" />
                <Grid>
                    <ui:TextBlock HorizontalAlignment="Left" Text="{x:Static res:Strings.ModeTrain}" />
                    <ui:TextBlock HorizontalAlignment="Right"
                                  Text="{Binding Data.Summary.Train}"
                                  AutomationProperties.AutomationId="TrainSummaryTrain" />
                </Grid>
                <Grid>
                    <ui:TextBlock HorizontalAlignment="Left" Text="{x:Static res:Strings.ModeVal}" />
                    <ui:TextBlock HorizontalAlignment="Right"
                                  Text="{Binding Data.Summary.Val}"
                                  AutomationProperties.AutomationId="TrainSummaryVal" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Options -->
        <ui:TextBlock Margin="0,0,0,4"
                      FontTypography="BodyStrong"
                      Text="{x:Static res:Strings.TrainOptionsHeader}" />

        <!-- Hardware recommendation (hidden until the probe has a result) -->
        <StackPanel Margin="0,0,0,6"
                    Visibility="{Binding Train.HasRecommendation, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,2"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Train.RecommendedText}"
                          TextWrapping="Wrap"
                          AutomationProperties.AutomationId="TrainRecommendedText" />
            <ui:Button HorizontalAlignment="Stretch"
                       Appearance="Secondary"
                       Content="{Binding Train.UseRecommendedText}"
                       Command="{Binding Train.UseRecommendedCommand}"
                       Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="TrainRecommendedApply" />
        </StackPanel>

        <!-- Trainer kind: Segment AI | YOLO / RT-DETR (same segmented toggle pattern as the Step 2 source switch) -->
        <Grid x:Name="TrainKindGrid"
              Margin="0,0,0,8"
              Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}"
              ToolTip="{x:Static res:Strings.TrainKindTip}"
              AutomationProperties.Name="{x:Static res:Strings.TrainOptionsHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0"
                         Margin="0,0,4,0"
                         Padding="4,4"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         GroupName="TrainKind"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         IsChecked="{Binding Train.IsSegmentKind, Mode=OneWay}"
                         CommandParameter="seg"
                         Command="{Binding Train.SetKindCommand}"
                         AutomationProperties.AutomationId="KindSegmentAi">
                <ui:TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource KindCaptionStyle}" Text="{x:Static res:Strings.TrainKindSegment}" />
            </RadioButton>
            <RadioButton Grid.Column="1"
                         Margin="0,0,4,0"
                         Padding="4,4"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         GroupName="TrainKind"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         IsChecked="{Binding Train.IsUltraKind, Mode=OneWay}"
                         CommandParameter="ultra"
                         Command="{Binding Train.SetKindCommand}"
                         AutomationProperties.AutomationId="KindUltra">
                <ui:TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource KindCaptionStyle}" Text="{x:Static res:Strings.TrainKindUltra}" />
            </RadioButton>
            <RadioButton Grid.Column="2"
                         Margin="0,0,4,0"
                         Padding="4,4"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         GroupName="TrainKind"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         IsChecked="{Binding Train.IsClassifyKind, Mode=OneWay}"
                         CommandParameter="classify"
                         Command="{Binding Train.SetKindCommand}"
                         AutomationProperties.AutomationId="KindClassify">
                <ui:TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource KindCaptionStyle}" Text="{Binding Train.ClassifyKindText, Mode=OneWay}" />
            </RadioButton>
            <RadioButton Grid.Column="3"
                         Padding="4,4"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         GroupName="TrainKind"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         IsChecked="{Binding Train.IsCounterAiKind, Mode=OneWay}"
                         CommandParameter="counterai"
                         Command="{Binding Train.SetKindCommand}"
                         AutomationProperties.AutomationId="KindCounterAi">
                <ui:TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource KindCaptionStyle}" Text="{x:Static res:Strings.TrainKindCounterAi}" />
            </RadioButton>
        </Grid>

        <!-- CounterAI (FastNet): iterations, device, weights, check, convert to OpenVINO. Start / Stop / progress are the shared ones below. -->
        <StackPanel Margin="0,0,0,8" Visibility="{Binding Train.IsCounterAiKind, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.CaIters}" />
            <TextBox Margin="0,0,0,8" Text="{Binding Train.CounterAiItersText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Train.IsIdle}" AutomationProperties.AutomationId="CounterAiIters" />
            <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.CaDevice}" />
            <ComboBox Margin="0,0,0,8" HorizontalAlignment="Stretch" IsEditable="True" Text="{Binding Train.CounterAiDevice, Mode=TwoWay}"
                      IsEnabled="{Binding Train.IsIdle}" AutomationProperties.AutomationId="CounterAiDevice">
                <ComboBoxItem Content="auto" />
                <ComboBoxItem Content="cuda" />
                <ComboBoxItem Content="xpu" />
                <ComboBoxItem Content="cpu" />
            </ComboBox>
            <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.CaWeights}" />
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,3" Content="{x:Static res:Strings.ExpBrowse}"
                        Command="{Binding CounterAiBar.BrowseWeightsCommand}" AutomationProperties.AutomationId="CounterAiBrowseWeightsTrain" />
                <TextBox Text="{Binding CounterAiBar.WeightsPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:Strings.CaBarWeightsTip}"
                         IsEnabled="{Binding Train.IsIdle}" AutomationProperties.AutomationId="CounterAiWeightsPathTrain" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,6">
                <Button Margin="0,0,6,4" Padding="10,3" Content="{x:Static res:Strings.CaCheck}" Command="{Binding Train.CheckCounterAiCommand}" AutomationProperties.AutomationId="CounterAiCheck" />
                <CheckBox Margin="0,0,6,4" VerticalAlignment="Center" Content="{x:Static res:Strings.CaFp32}" IsChecked="{Binding Train.CounterAiFp32}" />
                <Button Margin="0,0,6,4" Padding="10,3" Content="{x:Static res:Strings.CaConvert}" Command="{Binding Train.ConvertCounterAiCommand}" AutomationProperties.AutomationId="CounterAiConvert" />
                <Button Margin="0,0,0,4" Padding="10,3" Content="{x:Static res:Strings.CaUseConverted}" Command="{Binding Train.UseCounterAiConvertedCommand}" AutomationProperties.AutomationId="CounterAiUseConverted" />
            </WrapPanel>
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Train.CounterAiStatus}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Position project: Performance | Quality of the instance head (same segmented toggle as the trainer kind; hidden for Detect) -->
        <StackPanel Margin="0,0,0,8" Visibility="{Binding Train.ShowInstanceQuality, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.TrainInstanceQuality}" />
            <Grid AutomationProperties.AutomationId="InstanceQualityGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0"
                             Margin="0,0,4,0"
                             Padding="4,4"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             GroupName="InstanceQuality"
                             Style="{DynamicResource {x:Type ToggleButton}}"
                             IsChecked="{Binding Train.IsPerformanceInstance, Mode=OneWay}"
                             CommandParameter="performance"
                             Command="{Binding Train.SetInstanceQualityCommand}"
                             AutomationProperties.AutomationId="InstanceQualityPerformance">
                    <ui:TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource KindCaptionStyle}" Text="{x:Static res:Strings.InstanceQualityPerformance}" />
                </RadioButton>
                <RadioButton Grid.Column="1"
                             Padding="4,4"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             GroupName="InstanceQuality"
                             Style="{DynamicResource {x:Type ToggleButton}}"
                             IsChecked="{Binding Train.IsQualityInstance, Mode=OneWay}"
                             CommandParameter="quality"
                             Command="{Binding Train.SetInstanceQualityCommand}"
                             AutomationProperties.AutomationId="InstanceQualityQuality">
                    <ui:TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource KindCaptionStyle}" Text="{x:Static res:Strings.InstanceQualityQuality}" />
                </RadioButton>
            </Grid>
        </StackPanel>

        <!-- YOLO / RT-DETR: model family -->
        <!-- Advanced only: the family, epochs and input size, and the YOLO / RT-DETR batch with its status (the Ultra panels also need the Ultra kind). -->
        <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Visibility="{Binding Train.IsUltraKind, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.UltraFamily}" />
            <ComboBox Margin="0,0,0,8"
                      HorizontalAlignment="Stretch"
                      MinWidth="120"
                      ItemsSource="{Binding Train.Families}"
                      SelectedItem="{Binding Train.SelectedFamily, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding Train.IsIdle}"
                      ToolTip="{x:Static res:Strings.UltraFamily}"
                      AutomationProperties.AutomationId="UltraFamilyCombo"
                      AutomationProperties.Name="{x:Static res:Strings.UltraFamily}" />
        </StackPanel>

        <StackPanel Visibility="{Binding Train.ShowSegmentOptions, Converter={StaticResource BoolToVisibility}}">
        <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.TrainEpochs}" />
        <ui:NumberBox Margin="0,0,0,8"
                      Minimum="1"
                      Maximum="2000"
                      SmallChange="10"
                      LargeChange="50"
                      MaxDecimalPlaces="0"
                      SpinButtonPlacementMode="Inline"
                      Value="{Binding Train.EpochsValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding Train.IsIdle}"
                      ToolTip="{x:Static res:Strings.TrainEpochs}"
                      AutomationProperties.AutomationId="EpochsBox"
                      AutomationProperties.Name="{x:Static res:Strings.TrainEpochs}" />
        <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.TrainEarlyStop}" />
        <ui:NumberBox Margin="0,0,0,8"
                      Minimum="0"
                      Maximum="200"
                      SmallChange="5"
                      LargeChange="20"
                      MaxDecimalPlaces="0"
                      SpinButtonPlacementMode="Inline"
                      Value="{Binding Train.EarlyStopValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding Train.IsIdle}"
                      ToolTip="{x:Static res:Strings.TrainEarlyStopTip}"
                      AutomationProperties.AutomationId="EarlyStopBox"
                      AutomationProperties.Name="{x:Static res:Strings.TrainEarlyStop}" />
        <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.TrainInputSize}" />
        <ComboBox Margin="0,0,0,12"
                  HorizontalAlignment="Stretch"
                  MinWidth="120"
                  ItemsSource="{Binding Train.InputSizes}"
                  SelectedItem="{Binding Train.SelectedInputSize, Mode=TwoWay}"
                  IsEnabled="{Binding Train.IsIdle}"
                  ToolTip="{x:Static res:Strings.TrainInputSize}"
                  AutomationProperties.AutomationId="InputSizeCombo"
                  AutomationProperties.Name="{x:Static res:Strings.TrainInputSize}" />
        </StackPanel>

        <!-- YOLO / RT-DETR: batch size and the preflight status line -->
        <StackPanel Margin="0,0,0,4" Visibility="{Binding Train.IsUltraKind, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.UltraBatch}" />
            <ui:NumberBox Margin="0,0,0,8"
                          Minimum="0"
                          Maximum="512"
                          SmallChange="1"
                          LargeChange="8"
                          MaxDecimalPlaces="0"
                          SpinButtonPlacementMode="Inline"
                          Value="{Binding Train.BatchValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding Train.IsIdle}"
                          ToolTip="{x:Static res:Strings.UltraBatchTip}"
                          AutomationProperties.AutomationId="UltraBatchBox"
                          AutomationProperties.Name="{x:Static res:Strings.UltraBatch}" />
            <ui:TextBlock Margin="0,0,0,8"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Train.UltraStatusText}"
                          TextWrapping="Wrap"
                          AutomationProperties.AutomationId="UltraStatusText" />
        </StackPanel>
        </StackPanel>

        <!-- Start / Stop -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       Margin="0,0,8,0"
                       HorizontalAlignment="Stretch"
                       Appearance="Primary"
                       Content="{x:Static res:Strings.TrainStart}"
                       Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding Train.StartCommand}"
                       ToolTip="{Binding Train.StartToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="StartTrainButton" />
            <ui:Button Grid.Column="1"
                       Appearance="Secondary"
                       Content="{x:Static res:Strings.TrainStop}"
                       Icon="{ui:SymbolIcon Stop24}"
                       Command="{Binding Train.StopCommand}"
                       ToolTip="{x:Static res:Strings.TrainStop}"
                       AutomationProperties.AutomationId="StopTrainButton" />
        </Grid>

        <!-- Block reason with its fix (shown only when the block can be fixed with one click) -->
        <StackPanel Margin="0,0,0,8"
                    Visibility="{Binding Train.HasFix, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,4"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Train.FixText}"
                          TextWrapping="Wrap"
                          AutomationProperties.AutomationId="TrainFixText" />
            <ui:Button HorizontalAlignment="Stretch"
                       Appearance="Secondary"
                       Content="{Binding Train.FixButtonText}"
                       Command="{Binding Train.RunFixCommand}"
                       AutomationProperties.AutomationId="TrainFixButton" />
        </StackPanel>

        <!-- Progress -->
        <StackPanel Margin="0,0,0,6"
                    Visibility="{Binding Train.IsRunning, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Margin="0,0,0,2"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Train.ProgressValue, Mode=OneWay}"
                         AutomationProperties.AutomationId="TrainProgress" />
            <ui:TextBlock Text="{Binding Train.ProgressText}"
                          TextWrapping="Wrap"
                          AutomationProperties.AutomationId="TrainProgressText" />
            <ui:TextBlock Margin="0,2,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Train.EtaText}"
                          TextWrapping="Wrap"
                          Visibility="{Binding Train.HasEta, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.AutomationId="TrainEta" />
        </StackPanel>

        <!-- The live curves (LossChart, IouChart) are in TrainChartsView, the large central area of the Train tab. -->

        <!-- Models -->
        <ui:TextBlock Margin="0,0,0,4"
                      FontTypography="BodyStrong"
                      Text="{x:Static res:Strings.CandidatesHeader}" />
        <ui:ListView Margin="0,0,0,8"
                     MaxHeight="260"
                     ItemsSource="{Binding Train.Candidates}"
                     SelectedItem="{Binding Train.SelectedCandidate, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="CandidateList"
                     AutomationProperties.Name="{x:Static res:Strings.CandidatesHeader}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <ui:TextBlock DockPanel.Dock="Right"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="{Binding StateText}" />
                            <ui:TextBlock VerticalAlignment="Center"
                                          Text="{Binding FileName}"
                                          TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding DetailText}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding DetailText}" />
                    </StackPanel>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>

        <!-- Candidate versus active -->
        <StackPanel Margin="0,0,0,8"
                    Grid.IsSharedSizeScope="True"
                    Visibility="{Binding Train.HasComparison, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="CompareTable">
            <ui:TextBlock Margin="0,4,0,4"
                          FontTypography="BodyStrong"
                          Text="{x:Static res:Strings.CompareHeader}" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="40" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CompareCandidateCol" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CompareActiveCol" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CompareDeltaCol" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{x:Static res:Strings.CompareMetric}"
                              TextTrimming="CharacterEllipsis" />
                <ui:TextBlock Grid.Column="1"
                              Margin="0,0,5,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{x:Static res:Strings.CompareCandidate}" />
                <ui:TextBlock Grid.Column="2"
                              Margin="0,0,5,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{x:Static res:Strings.CompareActive}" />
                <ui:TextBlock Grid.Column="3"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{x:Static res:Strings.CompareDelta}"
                              TextTrimming="CharacterEllipsis" />
            </Grid>
            <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Train.ComparisonRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="40" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CompareCandidateCol" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CompareActiveCol" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CompareDeltaCol" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Margin="0,0,5,0"
                                          Text="{Binding MetricText}"
                                          TextWrapping="Wrap"
                                          ToolTip="{Binding MetricText}" />
                            <ui:TextBlock Grid.Column="1"
                                          Margin="0,0,5,0"
                                          Text="{Binding CandidateText}" />
                            <ui:TextBlock Grid.Column="2"
                                          Margin="0,0,5,0"
                                          Text="{Binding ActiveText}" />
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding VerdictText}"
                                        AutomationProperties.Name="{Binding VerdictText}">
                                <ui:SymbolIcon Margin="0,0,4,0"
                                               VerticalAlignment="Center"
                                               FontSize="14">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="QuestionCircle24" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Verdict}" Value="Better">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Verdict}" Value="Worse">
                                                    <Setter Property="Symbol" Value="DismissCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Verdict}" Value="Equal">
                                                    <Setter Property="Symbol" Value="SubtractCircle24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <ui:TextBlock VerticalAlignment="Center"
                                              Text="{Binding DeltaText}"
                                              TextTrimming="CharacterEllipsis">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Verdict}" Value="Better">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Verdict}" Value="Worse">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:InfoBar Margin="0,0,0,6"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{x:Static res:Strings.FlagDifferentValTitle}"
                        Message="{x:Static res:Strings.FlagDifferentValMessage}"
                        Visibility="{Binding Train.DifferentValidationSet, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="FlagDifferentValidation" />
            <ui:InfoBar Margin="0,0,0,6"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{x:Static res:Strings.FlagOverextTitle}"
                        Message="{x:Static res:Strings.FlagOverextMessage}"
                        Visibility="{Binding Train.BoxOverextension, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="FlagBoxOverextension" />
            <ui:InfoBar Margin="0,0,0,6"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="{x:Static res:Strings.FlagNoActiveTitle}"
                        Message="{x:Static res:Strings.FlagNoActiveMessage}"
                        Visibility="{Binding Train.NoActiveModel, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="FlagNoActiveModel" />
        </StackPanel>

        <ui:Button HorizontalAlignment="Stretch"
                   Appearance="Secondary"
                   Content="{x:Static res:Strings.UseModel}"
                   Icon="{ui:SymbolIcon CheckmarkCircle24}"
                   Command="{Binding Train.UseModelCommand}"
                   ToolTip="{x:Static res:Strings.UseModel}"
                   AutomationProperties.AutomationId="UseModelButton" />

        <!-- YOLO / RT-DETR runs (ultra-run.json of the open project); advanced only. -->
        <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
        <ui:Card Margin="0,12,0,0"
                 Padding="12,8,12,8"
                 Visibility="{Binding Train.ShowUltraRuns, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ui:TextBlock Margin="0,0,0,4"
                              FontTypography="BodyStrong"
                              Text="{x:Static res:Strings.UltraRunsHeader}" />
                <ui:ListView Margin="0,0,0,8"
                             MaxHeight="220"
                             ItemsSource="{Binding Train.UltraRuns}"
                             SelectedItem="{Binding Train.SelectedUltraRun, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="UltraRunList"
                             AutomationProperties.Name="{x:Static res:Strings.UltraRunsHeader}">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <ui:TextBlock Text="{Binding NameText}"
                                              TextTrimming="CharacterEllipsis"
                                              ToolTip="{Binding NameText}" />
                                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{Binding DetailText}"
                                              TextWrapping="Wrap"
                                              ToolTip="{Binding DetailText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
                <ui:Button HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Content="{x:Static res:Strings.UltraOpenFolder}"
                           Icon="{ui:SymbolIcon Folder24}"
                           Command="{Binding Train.OpenUltraFolderCommand}"
                           ToolTip="{x:Static res:Strings.UltraOpenFolder}"
                           ToolTipService.ShowOnDisabled="True"
                           AutomationProperties.AutomationId="UltraOpenFolderButton" />
                <!-- Detect runs only: installs the run's ONNX as the Custom YOLO model of the Label step's AI Model source. -->
                <ui:Button Margin="0,8,0,0"
                           HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Content="{x:Static res:Strings.UseModel}"
                           Icon="{ui:SymbolIcon CheckmarkCircle24}"
                           Command="{Binding Train.UseUltraRunCommand}"
                           ToolTip="{Binding Train.UseUltraRunTip}"
