<UserControl x:Class="EasyAI.Desktop.Views.InspectListPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Result colours follow the theme tokens (same brushes as the Train tab); the icon and the text carry the result too. -->
        <Style x:Key="VerdictCell" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="OK">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="NG">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Error">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- DataContext: InspectViewModel. Files and folders can be dropped anywhere on the panel. -->
    <Grid Background="Transparent"
          AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        ClearButtonEnabled="True"
                        PlaceholderText="{x:Static res:Strings.InspectSearch}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="InspectSearch"
                        AutomationProperties.Name="{x:Static res:Strings.InspectSearch}" />
            <ui:TextBlock Grid.Column="1"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding CountText}"
                          AutomationProperties.AutomationId="InspectCount" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="8,0,8,6" Orientation="Horizontal">
            <ComboBox Width="110"
                      Margin="0,0,6,0"
                      ItemsSource="{Binding FilterOptions}"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Filter, Mode=TwoWay}"
                      ToolTip="{x:Static res:Strings.InspectFilterTip}"
                      AutomationProperties.AutomationId="InspectFilter"
                      AutomationProperties.Name="{x:Static res:Strings.InspectFilterTip}" />
            <ui:Button Margin="0,0,6,0"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Content="{x:Static res:Strings.InspectAddFolder}"
                       Command="{Binding AddFolderCommand}"
                       ToolTip="{x:Static res:Strings.InspectAddFolderTip}"
                       AutomationProperties.AutomationId="InspectAddFolder" />
            <ui:Button Margin="0,0,6,0"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon ImageAdd24}"
                       Content="{x:Static res:Strings.InspectAddImages}"
                       Command="{Binding AddImagesCommand}"
                       ToolTip="{x:Static res:Strings.InspectAddImagesTip}"
                       AutomationProperties.AutomationId="InspectAddImages" />
            <ui:Button Margin="0,0,6,0"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon Camera24}"
                       Content="{x:Static res:Strings.InspectCapture}"
                       Command="{Binding Capture.CaptureToInspectCommand}"
                       ToolTip="{Binding Capture.InspectToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       Visibility="{Binding Capture.IsVisible, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="InspectCapture" />
            <ui:Button Appearance="Secondary"
                       Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding RemoveSelectedCommand}"
                       ToolTip="{x:Static res:Strings.InspectRemoveTip}"
                       AutomationProperties.AutomationId="InspectRemove"
                       AutomationProperties.Name="{x:Static res:Strings.InspectRemove}" />
        </WrapPanel>

        <ListView x:Name="InspectList"
                  Grid.Row="2"
                  Margin="4,0,4,4"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  PreviewKeyDown="OnListKeyDown"
                  GridViewColumnHeader.Click="OnHeaderClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.AutomationId="InspectList"
                  AutomationProperties.Name="{x:Static res:Strings.InspectListHeader}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="110" Header="{x:Static res:Strings.InspectColFile}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="70" Header="{x:Static res:Strings.InspectColVerdict}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Style="{StaticResource VerdictCell}">
                                    <ui:SymbolIcon Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Symbol="{Binding VerdictSymbol}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding VerdictText}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="46" Header="{x:Static res:Strings.Regions}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding RegionsText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="52" Header="{x:Static res:Strings.InspectColScore}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding ScoreText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Verdict confidence of an OK/NG model row; a dash for segmentation rows. The header comes from the view model (new key). -->
                    <GridViewColumn Width="64" Header="{Binding ConfidenceHeaderText}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding ConfidenceText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="52" Header="{x:Static res:Strings.InspectColMs}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding MsText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
