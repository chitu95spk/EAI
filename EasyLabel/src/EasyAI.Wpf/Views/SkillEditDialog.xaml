<ui:FluentWindow x:Class="EasyAI.Desktop.Views.SkillEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 Width="680"
                 Height="540"
                 MinWidth="420"
                 MinHeight="340"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="SkillEditDialog"
                 Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ui:TextBox x:Name="NameBox"
                    Grid.Row="1"
                    Margin="16,8,16,8"
                    PlaceholderText="{x:Static res:Strings.AgentsSkillNamePlaceholder}"
                    AutomationProperties.AutomationId="SkillName"
                    AutomationProperties.Name="{x:Static res:Strings.AgentsSkillNamePlaceholder}" />

        <ui:TextBox x:Name="TextBoxBody"
                    Grid.Row="2"
                    Margin="16,0,16,8"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    FontFamily="Consolas"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="SkillText"
                    AutomationProperties.Name="SKILL.md" />

        <ui:TextBlock x:Name="ErrorText"
                      Grid.Row="3"
                      Margin="16,0,16,4"
                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                      TextWrapping="Wrap"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="SkillError" />

        <StackPanel Grid.Row="4"
                    Margin="16,4,16,16"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0"
                       Appearance="Primary"
                       Content="{x:Static res:Strings.AgentsSave}"
                       Click="OnSave"
                       AutomationProperties.AutomationId="SkillSave" />
            <ui:Button Appearance="Secondary"
                       IsCancel="True"
                       Content="{x:Static res:Strings.Cancel}"
                       AutomationProperties.AutomationId="SkillCancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
