<ui:FluentWindow x:Class="EasyAI.Desktop.Views.OnlineStatusWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 xmlns:vm="clr-namespace:EasyAI.Desktop.ViewModels"
                 Title="{x:Static res:OnlineStrings.WindowTitle}"
                 Width="460"
                 MinWidth="360"
                 MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
                 SizeToContent="Height"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 Closed="OnClosed"
                 AutomationProperties.AutomationId="OnlineStatusWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:OnlineStrings.WindowTitle}"
                     ShowMaximize="False"
                     ShowMinimize="False" />
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,8,16,16">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Margin="0,4,10,0" VerticalAlignment="Top"
                             AutomationProperties.AutomationId="RunningIndicator">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <ui:TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap"
                                  AutomationProperties.AutomationId="OnlineStatusText" />
                </Grid>
                <ui:TextBlock Text="{x:Static res:OnlineStrings.Recipe}" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Text="{Binding RecipeId}" TextWrapping="Wrap" Margin="0,2,0,12"
                              AutomationProperties.AutomationId="RecipeId" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,8,12">
                        <ui:TextBlock Text="{x:Static res:OnlineStrings.Accepted}" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding Accepted}" TextWrapping="Wrap" FontSize="20"
                                      AutomationProperties.AutomationId="Accepted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,12">
                        <ui:TextBlock Text="{x:Static res:OnlineStrings.Completed}" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding Completed}" TextWrapping="Wrap" FontSize="20"
                                      AutomationProperties.AutomationId="Completed" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,8,0">
                        <ui:TextBlock Text="{x:Static res:OnlineStrings.Dropped}" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding Dropped}" TextWrapping="Wrap" FontSize="20"
                                      AutomationProperties.AutomationId="Dropped" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <ui:TextBlock Text="{x:Static res:OnlineStrings.Failed}" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding Failed}" TextWrapping="Wrap" FontSize="20"
                                      AutomationProperties.AutomationId="Failed" />
                    </StackPanel>
                </Grid>
                <ui:TextBlock Text="{Binding P95BudgetText}" TextWrapping="Wrap" Margin="0,0,0,12"
                              AutomationProperties.AutomationId="P95BudgetText">
                    <ui:TextBlock.Style>
                        <Style TargetType="ui:TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BudgetState}" Value="{x:Static vm:BudgetState.Ok}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BudgetState}" Value="{x:Static vm:BudgetState.Over}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:TextBlock.Style>
                </ui:TextBlock>
                <ui:Card Padding="12" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.ColumnSpan="2" Text="{x:Static res:OnlineStrings.Thresholds}"
                                      TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <StackPanel Grid.Row="1" Margin="0,0,6,0">
                            <ui:TextBlock Text="{x:Static res:OnlineStrings.Score}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsRunning}" TextWrapping="Wrap" MinWidth="0"
                                        AutomationProperties.Name="{x:Static res:OnlineStrings.Score}"
                                        AutomationProperties.AutomationId="OnlineScoreBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                            <ui:TextBlock Text="{x:Static res:OnlineStrings.Nms}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding NmsText, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsRunning}" TextWrapping="Wrap" MinWidth="0"
                                        AutomationProperties.Name="{x:Static res:OnlineStrings.Nms}"
                                        AutomationProperties.AutomationId="OnlineNmsBox" />
                        </StackPanel>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Command="{Binding ApplyThresholdCommand}" HorizontalAlignment="Right"
                                       HorizontalContentAlignment="Stretch" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                       MinWidth="0" AutomationProperties.Name="{x:Static res:OnlineStrings.Apply}"
                                       AutomationProperties.AutomationId="OnlineApplyButton">
                                <ui:TextBlock Text="{x:Static res:OnlineStrings.Apply}" TextWrapping="Wrap" />
                            </ui:Button>
                        </Grid>
                        <ui:TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ThresholdMessage}"
                                      TextWrapping="Wrap" Margin="0,8,0,0"
                                      AutomationProperties.AutomationId="ThresholdMessage" />
                    </Grid>
                </ui:Card>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Command="{Binding StopCommand}" Appearance="Primary" HorizontalAlignment="Right"
                               HorizontalContentAlignment="Stretch" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                               MinWidth="0" AutomationProperties.Name="{x:Static res:OnlineStrings.Stop}"
                               AutomationProperties.AutomationId="OnlineStopButton">
                        <ui:TextBlock Text="{x:Static res:OnlineStrings.Stop}" TextWrapping="Wrap" />
                    </ui:Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
