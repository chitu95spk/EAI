<UserControl x:Class="EasyAI.Desktop.Views.InspectTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- DataContext: MainViewModel (the Inspect tab state is Inspect). Right panel of the Inspect tab. -->
    <StackPanel>
        <!-- Model: the session holds one loaded model, shared with Auto-label; the panel says which one is loaded. -->
        <ui:TextBlock Margin="0,0,0,4"
                      FontTypography="BodyStrong"
                      Text="{x:Static res:Strings.ModelHeader}" />
        <ComboBox Margin="0,0,0,4"
                  HorizontalAlignment="Stretch"
                  MinWidth="120"
                  ItemsSource="{Binding Inspect.Models}"
                  DisplayMemberPath="Text"
                  SelectedValuePath="File"
                  SelectedValue="{Binding Inspect.SelectedModel, Mode=TwoWay}"
                  IsEnabled="{Binding Inspect.CanChooseModel}"
                  ToolTip="{x:Static res:Strings.InspectModelTip}"
                  AutomationProperties.AutomationId="InspectModelCombo"
                  AutomationProperties.Name="{x:Static res:Strings.InspectModelTip}" />
        <ui:TextBlock Margin="0,0,0,8"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Text="{Binding Inspect.LoadedModelText}"
                      AutomationProperties.AutomationId="InspectLoadedModel" />
        <!-- CounterAI pass rule: strand count (compare) value => OK, otherwise NG. -->
        <StackPanel Margin="0,0,0,8"
                    Visibility="{Binding Inspect.ShowCounterAiRule, Converter={StaticResource BoolToVisibility}}">
            <ui:TextBlock Margin="0,0,0,4" FontTypography="BodyStrong" Text="OK khi số đếm" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="70" Margin="0,0,8,0"
                          ItemsSource="{Binding Inspect.CompareOperators}"
                          SelectedItem="{Binding Inspect.SelectedCompare, Mode=TwoWay}"
                          AutomationProperties.AutomationId="InspectCompareOp" />
                <TextBox Width="80"
                         Text="{Binding Inspect.CompareValueText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="InspectCompareValue" />
            </StackPanel>
        </StackPanel>
        <ui:Button Margin="0,0,0,8"
                   HorizontalAlignment="Stretch"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Bot24}"
                   Content="{Binding Inspect.NewModelText}"
                   Command="{Binding Inspect.UseNewModelCommand}"
                   ToolTip="{x:Static res:Strings.InspectNewModelTip}"
                   Visibility="{Binding Inspect.HasNewModel, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="InspectUseNewModel" />
        <ui:TextBlock Margin="0,0,0,12"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Text="{Binding Inspect.SettingsText}"
                      AutomationProperties.AutomationId="InspectSettings" />
        <ui:Button Margin="0,0,0,12"
                   HorizontalAlignment="Stretch"
                   Appearance="Primary"
                   Content="{Binding Inspect.ClassifyFixText}"
                   Command="{Binding Inspect.FixClassifyCommand}"
                   Visibility="{Binding Inspect.HasClassifyFix, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="InspectClassifyFix" />

        <!-- Result of the run -->
        <ui:TextBlock Margin="0,0,0,8"
                      TextWrapping="Wrap"
                      Text="{Binding Inspect.SummaryText}"
                      Visibility="{Binding Inspect.HasSummary, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.AutomationId="InspectSummary" />

        <StackPanel Margin="0,0,0,8"
                    Visibility="{Binding Inspect.IsRunning, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Margin="0,0,0,4"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Inspect.ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding Inspect.IsProgressIndeterminate}"
                         AutomationProperties.AutomationId="InspectProgress" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              VerticalAlignment="Center"
                              Text="{Binding Inspect.ProgressText}"
                              AutomationProperties.AutomationId="InspectProgressText" />
                <ui:Button Grid.Column="1"
                           Appearance="Secondary"
                           Content="{x:Static res:Strings.Cancel}"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding Inspect.CancelRunCommand}"
                           ToolTip="{x:Static res:Strings.Cancel}"
                           AutomationProperties.AutomationId="InspectCancel" />
            </Grid>
        </StackPanel>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       Margin="0,0,3,4"
                       HorizontalAlignment="Stretch"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon ChevronRight24}"
                       Content="{x:Static res:Strings.InspectRunCurrent}"
                       Command="{Binding Inspect.RunCurrentCommand}"
                       ToolTip="{Binding Inspect.RunToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="InspectRunCurrent" />
            <ui:Button Grid.Column="1"
                       Margin="3,0,0,4"
                       HorizontalAlignment="Stretch"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Play24}"
                       Content="{x:Static res:Strings.InspectRunAll}"
                       Command="{Binding Inspect.RunAllCommand}"
                       ToolTip="{Binding Inspect.RunToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="InspectRunAll" />
        </Grid>
        <ui:Button HorizontalAlignment="Stretch"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Save24}"
                   Content="{x:Static res:Strings.InspectExportCsv}"
                   Command="{Binding Inspect.ExportCsvCommand}"
                   ToolTip="{x:Static res:Strings.InspectExportCsvTip}"
                   AutomationProperties.AutomationId="InspectExportCsv" />
    </StackPanel>
</UserControl>
