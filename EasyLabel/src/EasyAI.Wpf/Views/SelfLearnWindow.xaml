<ui:FluentWindow x:Class="EasyAI.Desktop.Views.SelfLearnWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
                 Title="{x:Static res:Strings.SlTitle}"
                 Width="1100"
                 Height="760"
                 MinWidth="640"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 AutomationProperties.AutomationId="SelfLearnDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:Strings.SlTitle}"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <TabControl Grid.Row="1"
                    Margin="16,8,16,16"
                    AutomationProperties.AutomationId="SelfLearnTabs">
            <!-- ================= Auto loop monitor ================= -->
            <TabItem Header="{x:Static res:Strings.SlTabMonitor}"
                     AutomationProperties.AutomationId="SelfLearnTabMonitor">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <ui:TextBlock Text="{x:Static res:Strings.SlRunFolder}" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Text="{Binding RunFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.AutomationId="SelfLearnRunFolder"
                                        AutomationProperties.Name="{x:Static res:Strings.SlRunFolder}" />
                            <ui:Button Grid.Column="1"
                                       Appearance="Secondary"
                                       Content="{x:Static res:Strings.ExpBrowse}"
                                       Command="{Binding BrowseRunCommand}"
                                       AutomationProperties.AutomationId="SelfLearnBrowseRun" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,8">
                        <ui:TextBlock FontSize="18"
                                      FontWeight="SemiBold"
                                      Text="{Binding StateText}"
                                      AutomationProperties.AutomationId="SelfLearnState" />
                        <ui:TextBlock Margin="0,4,0,0"
                                      Text="{Binding TargetText}"
                                      AutomationProperties.AutomationId="SelfLearnTarget" />
                        <ui:TextBlock Margin="0,2,0,0"
                                      Text="{Binding BestText}"
                                      AutomationProperties.AutomationId="SelfLearnBest" />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding Rounds}"
                              AutomationProperties.AutomationId="SelfLearnRounds">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColRound}" Binding="{Binding Round, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColModel}" Binding="{Binding Model, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColSynth}" Binding="{Binding Synth, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColEpochs}" Binding="{Binding Epochs, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColMap50}" Binding="{Binding Map50, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColRecall}" Binding="{Binding Recall, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="{x:Static res:Strings.SlColPrecision}" Binding="{Binding Precision, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:TextBlock Grid.Row="3"
                                  Margin="0,12,0,4"
                                  Text="{x:Static res:Strings.SlLogHeader}" />
                    <ui:TextBox Grid.Row="4"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                FontFamily="Consolas"
                                Text="{Binding LogText, Mode=OneWay}"
                                AutomationProperties.AutomationId="SelfLearnLog"
                                AutomationProperties.Name="{x:Static res:Strings.SlLogHeader}" />

                    <StackPanel Grid.Row="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,24,8"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Secondary"
                                   Content="{x:Static res:Strings.SlRefresh}"
                                   Command="{Binding RefreshRunCommand}"
                                   AutomationProperties.AutomationId="SelfLearnRefresh" />
                        <ui:Button Appearance="Danger"
                                   Content="{x:Static res:Strings.SlStop}"
                                   Command="{Binding StopCommand}"
                                   AutomationProperties.AutomationId="SelfLearnStop" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= OBB detect on a test folder ================= -->
            <TabItem Header="{x:Static res:Strings.SlTabDetect}"
                     AutomationProperties.AutomationId="SelfLearnTabDetect">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                IsEnabled="{Binding IsDetectIdle}">
                        <ui:TextBlock Text="{x:Static res:Strings.SlWeights}" />
                        <ui:TextBox Margin="0,4,0,12"
                                    Text="{Binding WeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="SelfLearnWeights"
                                    AutomationProperties.Name="{x:Static res:Strings.SlWeights}" />
                        <ui:TextBlock Text="{x:Static res:Strings.SlImages}" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Text="{Binding ImagesDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.AutomationId="SelfLearnImages"
                                        AutomationProperties.Name="{x:Static res:Strings.SlImages}" />
                            <ui:Button Grid.Column="1"
                                       Margin="0,0,16,0"
                                       Appearance="Secondary"
                                       Content="{x:Static res:Strings.ExpBrowse}"
                                       Command="{Binding BrowseImagesCommand}"
                                       AutomationProperties.AutomationId="SelfLearnBrowseImages" />
                            <ui:TextBlock Grid.Column="2"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Text="{x:Static res:Strings.SlConf}" />
                            <ui:TextBox Grid.Column="3"
                                        Text="{Binding ConfidenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.AutomationId="SelfLearnConf"
                                        AutomationProperties.Name="{x:Static res:Strings.SlConf}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Primary"
                                       Content="{x:Static res:Strings.SlDetect}"
                                       Command="{Binding DetectCommand}"
                                       AutomationProperties.AutomationId="SelfLearnDetect" />
                            <ui:Button Appearance="Secondary"
                                       Content="{x:Static res:Strings.Cancel}"
                                       Command="{Binding CancelDetectCommand}"
                                       AutomationProperties.AutomationId="SelfLearnCancelDetect" />
                        </StackPanel>
                        <ProgressBar Height="6"
                                     Margin="0,8,0,2"
                                     Minimum="0"
                                     Maximum="{Binding DetectMaximum}"
                                     Value="{Binding DetectValue, Mode=OneWay}"
                                     AutomationProperties.AutomationId="SelfLearnDetectProgress" />
                        <ui:TextBlock MinHeight="16"
                                      FontSize="11"
                                      Text="{Binding DetectProgressText}"
                                      AutomationProperties.AutomationId="SelfLearnDetectProgressText" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="240" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding DetectRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SelfLearnDetectRows">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.SlColImage}" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.SlColCount}" Binding="{Binding Count, Mode=OneWay}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.SlColGt}" Binding="{Binding Labelled, Mode=OneWay}" Width="1.6*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.SlColMs}" Binding="{Binding Ms, Mode=OneWay}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="2"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Image Stretch="Uniform"
                                   Source="{Binding PreviewImage}"
                                   AutomationProperties.AutomationId="SelfLearnPreview" />
                        </Border>
                    </Grid>

                    <ui:TextBlock Grid.Row="3"
                                  Margin="0,8,0,0"
                                  TextWrapping="Wrap"
                                  Text="{Binding DetectSummary}"
                                  AutomationProperties.AutomationId="SelfLearnDetectSummary" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
