<UserControl x:Class="EasyAI.Desktop.Views.ToolStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ann="clr-namespace:EasyAI.Desktop.Annotation"
             xmlns:edit="clr-namespace:EasyLabel.Core.Editing;assembly=EasyLabel.Core"
             xmlns:res="clr-namespace:EasyAI.Desktop.Resources"
             xmlns:infra="clr-namespace:EasyAI.Desktop.Infrastructure"
             Width="84">
    <UserControl.Resources>
        <ann:EnumToBooleanConverter x:Key="EnumToBool" />
        <BooleanToVisibilityConverter x:Key="FreeShapeToVisibility" />
        <!-- Caption under a tool glyph: text-on-accent colour while its tool button is checked (keyed, no BasedOn: the same pattern as SourceCaptionStyle). -->
        <Style x:Key="ToolCaptionStyle" TargetType="ui:TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource EasyAiAccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Drawn glyphs (point, line, linestrip): text colour, accent text colour while the tool button is checked. No BasedOn. -->
        <Style x:Key="ToolGlyphFillStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource EasyAiAccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolGlyphStrokeStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource EasyAiAccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Labelme-style left tool column (outside the docking area): one column, icon over text, equal width buttons. The tools scroll when the
         window is short; the round agent chat button stays pinned at the bottom. -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0"
                  Margin="4,4,0,4"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel AutomationProperties.AutomationId="ToolStrip"
                    AutomationProperties.Name="{x:Static res:Strings.ToolsGroup}">
            <StackPanel.Resources>
                <!-- Kept as it was: a Wpf-UI button template looks this implicit style up from here; do not remove. -->
                <Style TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type ui:TextBlock}}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="Width" Value="62" />
                    <Setter Property="FontSize" Value="9" />
                </Style>
                <Style TargetType="ui:SymbolIcon">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource EasyAiAccentTextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>

            <!-- Edit mode (Ctrl+J): Labelme has no such button in the strip; same size as the others so the column stays uniform. -->
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut EditMode, Text={x:Static res:Strings.ToolSelectTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Select}}"
                         AutomationProperties.AutomationId="ToolSelect"
                         AutomationProperties.Name="{x:Static res:Strings.ToolSelect}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="CursorClick24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolSelect}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolHand, Text={x:Static res:Strings.ToolHandTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Hand}}"
                         AutomationProperties.AutomationId="ToolHand"
                         AutomationProperties.Name="{x:Static res:Strings.ToolHand}">
                <StackPanel>
                    <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"
                          Data="M 7,11 L 7,4 C 7,2 10,2 10,4 L 10,10 L 10,2 C 10,0 13,0 13,2 L 13,10 L 13,3 C 13,1 16,1 16,3 L 16,11 L 16,6 C 16,4 19,4 19,6 L 19,13 C 19,17 17,21 14,22 L 9,22 C 6,21 5,19 4,17 L 1,12 C 0,10 2,9 3,10 L 7,14 Z"
                          Style="{StaticResource ToolGlyphFillStyle}" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolHand}" />
                </StackPanel>
            </RadioButton>
            <Separator Margin="0,2,0,4" />

            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolPolygon, Text={x:Static res:Strings.ToolPolygonTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Polygon}}"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolPolygon"
                         AutomationProperties.Name="{x:Static res:Strings.ToolPolygon}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="DrawShape24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolPolygon}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolRect, Text={x:Static res:Strings.ToolRectTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Rect}}"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolRect"
                         AutomationProperties.Name="{x:Static res:Strings.ToolRect}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="RectangleLandscape24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolRect}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolRot, Text={x:Static res:Strings.ToolRotTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Rot}}"
                         AutomationProperties.AutomationId="ToolRot"
                         AutomationProperties.Name="{x:Static res:Strings.ToolRot}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="ArrowRotateClockwise24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolRot}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolCircle, Text={x:Static res:Strings.ToolCircleTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Circle}}"
                         AutomationProperties.AutomationId="ToolCircle"
                         AutomationProperties.Name="{x:Static res:Strings.ToolCircle}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="Circle24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolCircle}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{x:Static res:Strings.ToolCountTip}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Count}}"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolCount"
                         AutomationProperties.Name="{x:Static res:Strings.ToolCount}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="NumberSymbol24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolCount}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolPoint, Text={x:Static res:Strings.ToolPointTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Point}}"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolPoint"
                         AutomationProperties.Name="{x:Static res:Strings.ToolPoint}">
                <StackPanel>
                    <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"
                          Data="{StaticResource GeoPoint}"
                          Style="{StaticResource ToolGlyphFillStyle}" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolPoint}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolLine, Text={x:Static res:Strings.ToolLineTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.Line}}"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolLine"
                         AutomationProperties.Name="{x:Static res:Strings.ToolLine}">
                <StackPanel>
                    <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"
                          Data="{StaticResource GeoLine}"
                          Style="{StaticResource ToolGlyphStrokeStyle}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolLine}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         ToolTip="{infra:Shortcut ToolLineStrip, Text={x:Static res:Strings.ToolLineStripTip}}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.LineStrip}}"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolLineStrip"
                         AutomationProperties.Name="{x:Static res:Strings.ToolLineStrip}">
                <StackPanel>
                    <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"
                          Data="{StaticResource GeoLineStrip}"
                          Style="{StaticResource ToolGlyphStrokeStyle}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolLineStrip}" />
                </StackPanel>
            </RadioButton>
            <Separator Margin="0,2,0,4" />
            <!-- AI-Points / AI-Box: enable state and tooltip (the reason) follow the Auto-label source; checked = the canvas tool. -->
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         IsEnabled="{Binding AiPointsEnabled}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.AiPoints}}"
                         ToolTip="{Binding AiPointsToolTip}"
                         ToolTipService.ShowOnDisabled="True"
                         Visibility="{Binding AllowsFreeShapeTools, Converter={StaticResource FreeShapeToVisibility}}"
                         AutomationProperties.AutomationId="ToolAiPoints"
                         AutomationProperties.Name="{x:Static res:Strings.MiAiPoints}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="Bot24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolAiPointsShort}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="CanvasTool" Width="72" Height="44" Margin="0,0,0,1" Padding="2,2,2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Style="{DynamicResource {x:Type ToggleButton}}"
                         IsEnabled="{Binding AiBoxEnabled}"
                         IsChecked="{Binding Tool, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static edit:CanvasTool.AiBox}}"
                         ToolTip="{Binding AiBoxToolTip}"
                         ToolTipService.ShowOnDisabled="True"
                         AutomationProperties.AutomationId="ToolAiBox"
                         AutomationProperties.Name="{x:Static res:Strings.MiAiBox}">
                <StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16" Symbol="Wand24" />
                    <ui:TextBlock Style="{StaticResource ToolCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="62" FontSize="9" Text="{x:Static res:Strings.ToolAiBoxShort}" />
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </ScrollViewer>
    <ui:Button x:Name="AgentChatRoundButton" Grid.Row="1"
               Width="44" Height="44" Padding="0"
               Margin="4,0,0,10"
               HorizontalAlignment="Center"
               CornerRadius="22"
               Appearance="Primary"
               Icon="{ui:SymbolIcon Chat24}"
               Command="{Binding AgentChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
               ToolTip="{x:Static res:Strings.AgentChatTitle}"
               AutomationProperties.AutomationId="AgentChatButton"
               AutomationProperties.Name="{x:Static res:Strings.AgentChatTitle}" />
    </Grid>
</UserControl>
