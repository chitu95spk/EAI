<Project Sdk="Microsoft.NET.Sdk">

  <!-- SAM3 image encoder on the NVIDIA GPU (CUDA 13 + cuDNN 9) in its own process. It cannot live in EasyAI.exe: the DirectML package and the GPU package
       both ship onnxruntime.dll. EasyAI copies this output, plus Lib\native\cuda13\*.dll, to <OutDir>cuda\. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>EasyLabel.Ai.Sam3Cuda</RootNamespace>
    <AssemblyName>Sam3CudaWorker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
  </ItemGroup>

</Project>
