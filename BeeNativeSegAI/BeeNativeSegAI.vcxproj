  <!-- SEG-LIFECYCLE-r11: optional libtorch (Release|x64 only, needs ThirdParty\libtorch\lib\torch.lib). Without it the project
       builds with BEESEGAI_TORCH=0. torch_cpu.dll is delay-loaded (c10.dll cannot be: it exports data symbols) so inference-only machines never load them. -->
  <PropertyGroup>
    <SegTorchRoot Condition="'$(SegTorchRoot)' == ''">$(MSBuildThisFileDirectory)..\ThirdParty\libtorch</SegTorchRoot>
    <SegTorchEnabled Condition="'$(Configuration)|$(Platform)' == 'Release|x64' And Exists('$(SegTorchRoot)\lib\torch.lib')">true</SegTorchEnabled>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(SegTorchEnabled)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(SegTorchRoot)\include;$(SegTorchRoot)\include\torch\csrc\api\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>BEESEGAI_TORCH=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(SegTorchRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>torch.lib;torch_cpu.lib;c10.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>torch_cpu.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CopySegTorchRuntime" AfterTargets="Build" Condition="'$(SegTorchEnabled)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <SegTorchDll Include="$(SegTorchRoot)\lib\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SegTorchDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="..\BuildSupport\EasyVisionSegAIRuntime.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
